# ============================================================
# .env.example
# Copy this file to .env and fill in your local values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/hilfe
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── ARMS SSO ─────────────────────────────────────────────────
# GET endpoint that validates the token and returns the user profile
ARMS_SSO_URL=https://arms.example.com/api/sso/validate
# RSA public key ARMS signs SSO tokens with (RS256), used to verify tokens locally.
# PEM format, newlines escaped as \n within the quoted value.
ARMS_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Cookie ───────────────────────────────────────────────────
# true in production (HTTPS only), false for local HTTP dev
COOKIE_SECURE=false

# ── Encryption at rest ───────────────────────────────────────
# Random secrets of at least 32 characters. The app refuses to start without them.
ENCRYPTION_KEY=your_slack_token_encryption_key_here
FIELD_ENCRYPTION_KEY=your_ticket_content_encryption_key_here

# ── CORS ─────────────────────────────────────────────────────
# Primary comma-separated list of allowed frontend origins (e.g. production/staging URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Additional origins always merged on top of CORS_ALLOWED_ORIGINS.
# Defaults to localhost:4200,localhost:3000 so local dev works out of the box.
# Set to empty string to disable: CORS_EXTRA_ALLOWED_ORIGINS=
CORS_EXTRA_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
