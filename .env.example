# ============================================================
# .env.example
# Copy this file to .env and fill in your local values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/hilfe
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── JWT ──────────────────────────────────────────────────────
# Must be >= 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRY_MS=3600000

# ── ARMS SSO ─────────────────────────────────────────────────
# GET endpoint that validates the token and returns the user profile
ARMS_SSO_URL=https://arms.example.com/api/sso/validate

# ── Cookie ───────────────────────────────────────────────────
# true in production (HTTPS only), false for local HTTP dev
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────
# Primary comma-separated list of allowed frontend origins (e.g. production/staging URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Additional origins always merged on top of CORS_ALLOWED_ORIGINS.
# Defaults to localhost:4200,localhost:3000 so local dev works out of the box.
# Set to empty string to disable: CORS_EXTRA_ALLOWED_ORIGINS=
CORS_EXTRA_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
