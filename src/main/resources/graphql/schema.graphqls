scalar Instant
scalar Long

# ──────────────────────────────────────
# SHARED TYPES
# ──────────────────────────────────────

type PageInfo {
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

type Lookup {
  id: ID!
  name: String!
}

type Creator {
  id: ID!
  fullName: String
  profileImage: String
}

type AssignedAgent {
  agentId: ID!
  fullName: String
  email: String
  profileImg: String
  locationId: ID
  locationName: String
}

type MediaFile {
  id: ID!
  originalName: String!
  contentType: String!
  fileSize: Long
  url: String
}

type PresignedUrl {
  uploadUrl: String!
  fileKey: String!
  expiresInSeconds: Long!
}

# ──────────────────────────────────────
# AUTH
# ──────────────────────────────────────

type AuthSession {
  userId: ID!
  email: String!
  fullName: String
  profileImg: String
  role: String!
  permissions: [String!]
}

type UserPermissions {
  userId: ID!
  permissions: [String!]
}

# ──────────────────────────────────────
# INCIDENTS
# ──────────────────────────────────────

type IncidentSla {
  responseThresholdMinutes: Int
  resolutionThresholdMinutes: Int
  responseThresholdSeconds: Long
  resolutionThresholdSeconds: Long
  responseDueAt: Instant
  resolutionDueAt: Instant
  firstResponseAt: Instant
  responseBreachedAt: Instant
  resolutionBreachedAt: Instant
  responseStatus: String
  resolutionStatus: String
  paused: Boolean!
}

type Incident {
  id: ID!
  incidentNo: Int!
  title: String!
  description: String!
  incidentTopic: IncidentTopic
  location: Location
  priority: Lookup
  status: Lookup
  createdBy: Creator
  assignedTo: AssignedAgent
  read: Boolean!
  statusReason: String
  resolvedAt: Instant
  closedAt: Instant
  createdAt: Instant!
  updatedAt: Instant!
  sla: IncidentSla
  attachments: [MediaFile!]
}

type IncidentPage {
  items: [Incident!]!
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

# ──────────────────────────────────────
# MESSAGES
# ──────────────────────────────────────

type MessageSender {
  userId: ID!
  fullName: String
  profileImg: String
}

type Message {
  id: ID!
  incidentId: ID!
  sender: MessageSender
  content: String
  attachments: [MediaFile!]
  createdAt: Instant!
  updatedAt: Instant!
}

type MessagePage {
  items: [Message!]!
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

# ──────────────────────────────────────
# INTERNAL NOTES
# ──────────────────────────────────────

type InternalNote {
  id: ID!
  incidentId: ID!
  body: String!
  author: MessageSender
  isOwner: Boolean!
  createdAt: Instant!
  updatedAt: Instant!
}

type InternalNotePage {
  items: [InternalNote!]!
  page: Int!
  size: Int!
  totalElements: Long!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

