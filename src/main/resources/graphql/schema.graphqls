type Query {
    agentDashboard: AgentDashboardSummary!
    adminDashboard: AdminDashboardSummary!
}

type AgentDashboardSummary {
    totalAssigned: Int!
    byStatus: [StatusCount!]!
    highCriticalCount: Int!
    unacknowledgedCount: Int!
    closedThisWeek: Int!
    avgResolutionHours: Float
    recentlyUpdated: [DashboardIncident!]!
}

type StatusCount {
    status: String!
    count: Int!
}

type DashboardIncident {
    id: String!
    incidentNo: Int!
    title: String!
    status: String
    severity: String
    updatedAt: String!
}

type AdminDashboardSummary {
    totalTickets: Int!
    unassignedCount: Int!
    slaBreachCount: Int!
    byStatus: [LabelCount!]!
    byCategory: [LabelCount!]!
    byTopic: [LabelCount!]!
    agentWorkload: [AgentWorkload!]!
    recentActivity: [RecentActivity!]!
}

type LabelCount {
    label: String!
    count: Int!
}

type AgentWorkload {
    agentUserId: String!
    assignedCount: Int!
}

type RecentActivity {
    actorUserId: String!
    action: String!
    subjectType: String
    subjectId: String
    description: String
    createdAt: String!
}
